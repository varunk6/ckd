{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/(health|dataset-info|model-info|metrics|blood-pressure|lab-results|wearable-logs|health-summary|predict|explain|predictions|feature-selection)",
      "dest": "api/index.py"
    },
    {
      "src": "/(eda/.*|models/.*|experiment/.*|report/.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
